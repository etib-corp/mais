PROJECT_NAME           = "maïs"
PROJECT_BRIEF          = "Reusable C++ scripting runtime embedding Python through pybind11"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
OUTPUT_DIRECTORY       = @CMAKE_BINARY_DIR@/docs
INPUT                  = @HEADERS_DIR@ \
                         @CMAKE_SOURCE_DIR@/docs/ARCHITECTURE.md \
                         @CMAKE_SOURCE_DIR@/docs/GETTING_STARTED.md \
                         @CMAKE_SOURCE_DIR@/docs/ERROR_HANDLING.md \
                         @CMAKE_SOURCE_DIR@/docs/ROADMAP.md \
                         @CMAKE_SOURCE_DIR@/docs/MILESTONES.md \
                         @CMAKE_SOURCE_DIR@/docs/TECHNICAL_CHOICES.md \
                         @CMAKE_SOURCE_DIR@/docs/VERSIONING.md \
                         @CMAKE_SOURCE_DIR@/README.md
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.md
USE_MDFILE_AS_MAINPAGE = @CMAKE_SOURCE_DIR@/README.md
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
SOURCE_BROWSER         = NO
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO
MACRO_EXPANSION        = YES
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = NO
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = NO
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = @CMAKE_SOURCE_DIR@
STRIP_FROM_INC_PATH    = @HEADERS_DIR@
TAB_SIZE               = 4
ALIASES                = "threadsafe=@par Thread safety:\n"
